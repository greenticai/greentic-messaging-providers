  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/webex/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.generated-secrets.v1": {
      "kind": "greentic.generated-secrets.v1",
      "version": "0.5.19",
      "inline": {
        "secrets": [
          {
            "key": "webex_webhook_secret",
            "aliases": [
              "WEBEX_WEBHOOK_SECRET"
            ],
            "required": true,
            "policy": "random",
            "length": 20,
            "encoding": "raw_text",
            "scope": {
              "level": "tenant",
              "team": "_"
            },
            "regenerate_if_present": false,
            "description": "Shared secret used to verify Webex webhook signatures."
          }
        ]
      }
    },
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.5.19",
      "inline": {
        "offers": [
          {
            "cap_id": "greentic.cap.messaging.provider.v1",
            "offer_id": "messaging-webex-v1",
            "priority": 100,
            "provider": {
              "component_ref": "messaging-provider-webex",
              "op": "messaging.configure"
            },
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-webex"
            },
            "version": "0.5.19"
          }
        ],
        "schema_version": 1
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.5.19",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.setup.actions.v1": {
      "kind": "greentic.setup.actions.v1",
      "version": "1",
      "inline": {
        "schema_id": "greentic.setup.actions.v1",
        "provider_id": "messaging-webex",
        "actions": [
          {
            "id": "add-to-webex",
            "label": "Add to Webex",
            "kind": "deep_link",
            "url_template": "webexteams://im?email={bot_email}",
            "style": "primary",
            "opens_new_window": true,
            "copyable": true,
            "requires": [
              "bot_email"
            ],
            "visible_when": {
              "setup_status.ok": true
            }
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.5.19",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.webex.bot",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "reply",
              "ingest_http",
              "render_plan",
              "encode",
              "send_payload",
              "setup_webhook",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/webex/public.config.schema.json",
            "setup_contract": {
              "version": 1,
              "config_out": {
                "bot_email": "bot_email"
              },
              "secrets_out": [
                {
                  "answer_key": "webex_bot_token",
                  "secret_key": "WEBEX_BOT_TOKEN",
                  "aliases": [
                    "bot_token"
                  ]
                }
              ]
            },
            "runtime": {
              "component_ref": "messaging-provider-webex",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-provider-webex",
        "kind": "egress",
        "name": "messaging.webex.bot"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "WEBEX_BOT_TOKEN",
      "scope": "tenant",
      "description": "Webex bot access token used for Messages API calls."
    }
  ],
  "capabilities_cache": [
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "templates",
      "version": "v1",
      "path": "components/templates-capabilities_v1.json"
    }
  ]
}
