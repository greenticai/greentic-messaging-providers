    "ai.greentic.component-templates",
    "messaging-ingress-telegram",
    "messaging-provider-telegram",
    "templates"
  ],
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/telegram/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.5.9",
      "inline": {
        "offers": [
          {
            "cap_id": "greentic.cap.messaging.provider.v1",
            "offer_id": "messaging-telegram-v1",
            "priority": 100,
            "provider": {
              "component_ref": "messaging-provider-telegram",
              "op": "messaging.configure"
            },
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-telegram"
            },
            "version": "0.5.9"
          }
        ],
        "schema_version": 1
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.5.9",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.setup.actions.v1": {
      "kind": "greentic.setup.actions.v1",
      "version": "1",
      "inline": {
        "schema_id": "greentic.setup.actions.v1",
        "provider_id": "messaging-telegram",
        "actions": [
          {
            "id": "add-to-telegram",
            "label": "Add to Telegram",
            "kind": "deep_link",
            "url_template": "https://t.me/{bot_username}",
            "style": "primary",
            "opens_new_window": true,
            "copyable": true,
            "requires": [
              "bot_username"
            ],
            "visible_when": {
              "setup_status.ok": true
            }
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.5.9",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.telegram.bot",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "reply",
              "ingest_http",
              "render_plan",
              "encode",
              "send_payload",
              "send_typing",
              "setup_webhook",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/telegram/public.config.schema.json",
            "setup_contract": {
              "version": 1,
              "config_out": {
                "public_base_url": "public_base_url",
                "bot_username": "bot_username",
                "default_chat_id": "default_chat_id",
                "api_base_url": "api_base_url"
              },
              "secrets_out": [
                {
                  "answer_key": "telegram_bot_token",
                  "secret_key": "TELEGRAM_BOT_TOKEN",
                  "aliases": [
                    "bot_token"
                  ]
                }
              ]
            },
            "runtime": {
              "component_ref": "messaging-provider-telegram",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    },
    "messaging.provider_ingress.v1": {
      "kind": "messaging.provider_ingress.v1",
      "version": "0.5.9",
      "inline": {
        "capabilities": {
          "content_types": [
            "application/json"
          ],
          "supports_webhook_validation": true
        },
        "component_ref": "messaging-ingress-telegram",
        "export": "handle-webhook",
        "world": "greentic:messaging-ingress-telegram/messaging-ingress-telegram@0.0.1"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-ingress-telegram",
        "kind": "ingress",
        "name": "messaging.telegram.ingress"
      },
      {
        "component": "messaging-provider-telegram",
        "kind": "egress",
        "name": "messaging.telegram.bot"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "TELEGRAM_BOT_TOKEN",
      "scope": "tenant",
      "description": "Telegram bot token used for sendMessage requests."
    }
  ],
  "capabilities_cache": [
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "templates",
      "version": "v1",
      "path": "components/templates-capabilities_v1.json"
    }
  ]
}
