    "ai.greentic.component-templates",
    "messaging-ingress-whatsapp",
    "messaging-provider-whatsapp",
    "templates"
  ],
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/whatsapp/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.5.8",
      "inline": {
        "offers": [
          {
            "cap_id": "greentic.cap.messaging.provider.v1",
            "offer_id": "messaging-whatsapp-v1",
            "priority": 100,
            "provider": {
              "component_ref": "messaging-provider-whatsapp",
              "op": "messaging.configure"
            },
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-whatsapp"
            },
            "version": "0.5.8"
          }
        ],
        "schema_version": 1
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.5.8",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.5.8",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.whatsapp.cloud",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "reply",
              "ingest_http",
              "render_plan",
              "encode",
              "send_payload",
              "send_typing",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/whatsapp/public.config.schema.json",
            "setup_contract": {
              "version": 1,
              "config_out": {
                "phone_number_id": "phone_number_id",
                "public_base_url": "public_base_url",
                "business_account_id": "business_account_id",
                "api_base_url": "api_base_url",
                "api_version": "api_version"
              },
              "secrets_out": [
                {
                  "answer_key": "whatsapp_token",
                  "secret_key": "WHATSAPP_TOKEN",
                  "aliases": [
                    "access_token",
                    "token"
                  ]
                },
                {
                  "answer_key": "whatsapp_verify_token",
                  "secret_key": "WHATSAPP_VERIFY_TOKEN"
                },
                {
                  "answer_key": "whatsapp_app_secret",
                  "secret_key": "WHATSAPP_APP_SECRET"
                }
              ]
            },
            "runtime": {
              "component_ref": "messaging-provider-whatsapp",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    },
    "messaging.provider_ingress.v1": {
      "kind": "messaging.provider_ingress.v1",
      "version": "0.5.8",
      "inline": {
        "capabilities": {
          "content_types": [
            "application/json"
          ],
          "supports_webhook_validation": true
        },
        "component_ref": "messaging-ingress-whatsapp",
        "export": "handle-webhook",
        "world": "greentic:messaging-ingress-whatsapp/messaging-ingress-whatsapp@0.0.1"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-ingress-whatsapp",
        "kind": "ingress",
        "name": "messaging.whatsapp.ingress"
      },
      {
        "component": "messaging-provider-whatsapp",
        "kind": "egress",
        "name": "messaging.whatsapp.cloud"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "WHATSAPP_VERIFY_TOKEN",
      "scope": "tenant",
      "description": "Verify token used for WhatsApp webhook validation (if configured)."
    },
    {
      "name": "WHATSAPP_TOKEN",
      "scope": "tenant",
      "description": "WhatsApp Cloud API access token."
    },
    {
      "name": "WHATSAPP_APP_SECRET",
      "scope": "tenant",
      "description": "Meta app secret used to verify webhook signatures (optional).",
      "required": false
    }
  ],
  "capabilities_cache": [
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "templates",
      "version": "v1",
      "path": "components/templates-capabilities_v1.json"
    }
  ]
}
