  "components": [
    "ai.greentic.component-templates",
    "messaging-ingress-slack",
    "messaging-provider-slack",
    "templates"
  ],
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/slack/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.5.23",
      "inline": {
        "offers": [
          {
            "cap_id": "greentic.cap.messaging.provider.v1",
            "offer_id": "messaging-slack-v1",
            "priority": 100,
            "provider": {
              "component_ref": "messaging-provider-slack",
              "op": "messaging.configure"
            },
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-slack"
            },
            "version": "0.5.23"
          }
        ],
        "schema_version": 1
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.5.23",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.setup.actions.v1": {
      "kind": "greentic.setup.actions.v1",
      "version": "1",
      "inline": {
        "schema_id": "greentic.setup.actions.v1",
        "provider_id": "messaging-slack",
        "actions": [
          {
            "id": "add-to-slack",
            "label": "Add to Slack",
            "kind": "deep_link",
            "url_template": "https://slack.com/app_redirect?app={slack_app_id}",
            "style": "primary",
            "opens_new_window": true,
            "copyable": true,
            "requires": [
              "slack_app_id"
            ],
            "visible_when": {
              "setup_status.ok": true
            }
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.5.23",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.slack.api",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "reply",
              "ingest_http",
              "render_plan",
              "encode",
              "send_payload",
              "approval_request",
              "setup_app_registration",
              "setup_webhook",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/slack/public.config.schema.json",
            "setup_contract": {
              "version": 1,
              "config_out": {
                "public_base_url": "public_base_url",
                "default_channel": "default_channel",
                "api_base_url": "api_base_url",
                "slack_app_id": "slack_app_id"
              },
              "secrets_out": [
                {
                  "answer_key": "bot_token",
                  "secret_key": "SLACK_BOT_TOKEN"
                },
                {
                  "answer_key": "slack_configuration_access_token",
                  "secret_key": "SLACK_CONFIGURATION_ACCESS_TOKEN",
                  "aliases": [
                    "slack_configuration_token"
                  ]
                },
                {
                  "answer_key": "slack_configuration_refresh_token",
                  "secret_key": "SLACK_CONFIGURATION_REFRESH_TOKEN"
                },
                {
                  "answer_key": "slack_signing_secret",
                  "secret_key": "SLACK_SIGNING_SECRET"
                }
              ]
            },
            "runtime": {
              "component_ref": "messaging-provider-slack",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    },
    "messaging.oauth.v1": {
      "kind": "messaging.oauth.v1",
      "version": "0.5.23",
      "inline": {
        "auth_type": "oauth2",
        "authorize_url": "https://slack.com/oauth/v2/authorize",
        "provider_id": "slack",
        "redirect_path": "/oauth/callback/slack",
        "scopes": [
          "chat:write",
          "channels:read",
          "channels:history"
        ],
        "secret_keys": [
          "SLACK_BOT_TOKEN"
        ],
        "token_url": "https://slack.com/api/oauth.v2.access"
      }
    },
    "messaging.provider_ingress.v1": {
      "kind": "messaging.provider_ingress.v1",
      "version": "0.5.23",
      "inline": {
        "capabilities": {
          "content_types": [
            "application/json"
          ],
          "supports_webhook_validation": true
        },
        "component_ref": "messaging-ingress-slack",
        "export": "handle-webhook",
        "world": "greentic:messaging-ingress-slack/messaging-ingress-slack@0.0.1"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-ingress-slack",
        "kind": "ingress",
        "name": "messaging.slack.ingress"
      },
      {
        "component": "messaging-provider-slack",
        "kind": "egress",
        "name": "messaging.slack.api"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "SLACK_CONFIGURATION_ACCESS_TOKEN",
      "scope": "tenant",
      "description": "Slack configuration access token for manifest updates during webhook registration."
    },
    {
      "name": "SLACK_CONFIGURATION_REFRESH_TOKEN",
      "scope": "tenant",
      "description": "Slack configuration refresh token used to rotate expired configuration access tokens."
    }
  ],
  "capabilities_cache": [
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "templates",
      "version": "v1",
      "path": "components/templates-capabilities_v1.json"
    }
  ]
}
