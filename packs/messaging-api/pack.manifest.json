{
  "name": "messaging-api",
  "version": "0.5.0",
  "kind": "application",
  "publisher": "Greentic",
  "description": "Programmatic messaging channel - send by REST, receive by SSE stream, polling or webhook.",
  "component_sources": [
    {
      "id": "messaging-provider-api",
      "version": "0.5.0",
      "world": "greentic:component/component-v0-v6-v0@0.6.1",
      "supports": [
        "messaging"
      ],
      "profiles": {
        "default": "default",
        "supported": [
          "default"
        ]
      },
      "capabilities": {
        "wasi": {
          "random": false,
          "clocks": false
        },
        "host": {}
      },
      "wasm": "components/messaging-provider-api/component.wasm",
      "manifest": "components/messaging-provider-api/component.manifest.json"
    }
  ],
  "components": [
    "messaging-provider-api"
  ],
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/api/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.5.0",
      "inline": {
        "schema_version": 1,
        "offers": [
          {
            "offer_id": "messaging-api-v1",
            "cap_id": "greentic.cap.messaging.provider.v1",
            "version": "0.5.0",
            "provider": {
              "component_ref": "messaging-provider-api",
              "op": "messaging.configure"
            },
            "priority": 100,
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-api"
            }
          }
        ]
      }
    },
    "greentic.http-routes.v1": {
      "kind": "greentic.http-routes.v1",
      "version": "0.5.0",
      "inline": {
        "schema_version": 1,
        "routes": [
          {
            "domain": "messaging",
            "id": "api-messages",
            "methods": [
              "GET",
              "POST"
            ],
            "pattern": "/v1/messaging/api/{tenant}/messages",
            "provider_op": "ingest_http"
          },
          {
            "domain": "messaging",
            "id": "api-messages-bundle",
            "methods": [
              "GET",
              "POST"
            ],
            "pattern": "/v1/messaging/api/{tenant}/{bundle}/messages",
            "provider_op": "ingest_http"
          }
        ]
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.5.0",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.5.0",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.api",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "ingest_http",
              "poll_events",
              "render_plan",
              "encode",
              "send_payload",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/api/public.config.schema.json",
            "runtime": {
              "component_ref": "messaging-provider-api",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    },
    "messaging.provider_ingress.v1": {
      "kind": "messaging.provider_ingress.v1",
      "version": "0.5.0",
      "inline": {
        "capabilities": {
          "content_types": [
            "application/json"
          ],
          "supports_webhook_validation": false
        },
        "component_ref": "messaging-provider-api",
        "export": "handle-webhook",
        "world": "provider:common/ingress@0.0.2"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-provider-api",
        "kind": "egress",
        "name": "messaging.dummy"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "API_CHANNEL_API_KEY",
      "scope": "tenant",
      "description": "Bearer API key clients present."
    },
    {
      "name": "API_CHANNEL_WEBHOOK_SECRET",
      "scope": "tenant",
      "description": "Webhook signing secret."
    },
    {
      "name": "DUMMY_API_TOKEN",
      "scope": "tenant",
      "description": "Dummy provider token (redacted in describe/config metadata)."
    },
    {
      "name": "DUMMY_TOKEN",
      "scope": "tenant",
      "description": "Dummy token used for conformance setup validation."
    }
  ]
}
